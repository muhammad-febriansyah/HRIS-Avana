APP_NAME=AvanaHR
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
MAINTENANCE_MODE=false
MAINTENANCE_SECRET=
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=960

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

PAKASIR_BASE_URL=https://app.pakasir.com
PAKASIR_SLUG=avanahr
PAKASIR_API_KEY=

# Deepgram project key for the meeting recorder (Rapat & Transkrip). Optional —
# a key saved in Pengaturan AI takes precedence. Never sent to the phone.
DEEPGRAM_API_KEY=

# Private Python face-recognition service. Keep this URL and key server-side;
# Flutter uploads face images to Laravel, never directly to FastAPI.
FACE_SERVICE_URL=http://127.0.0.1:8000
FACE_SERVICE_API_KEY=
FACE_SERVICE_MODEL_VERSION=sface-2021dec-v1
FACE_DUPLICATE_THRESHOLD=0.6
FACE_SERVICE_CONNECT_TIMEOUT=3
FACE_SERVICE_TIMEOUT=20

# Mobile session length. The access token is short (JWT_TTL, 60 minutes) and is
# renewed silently, so JWT_REFRESH_TTL is what actually decides how long a phone
# may be away from the network before the employee has to sign in again. 90 days.
# Kept in step with AuthService.offlineSessionWindow in the Flutter app — a test
# there pins the number, so changing one side alone fails the build.
JWT_TTL=60
JWT_REFRESH_TTL=129600

# --- Keamanan ---------------------------------------------------------------
# Content-Security-Policy dikirim sebagai report-only sampai dinyalakan. Buka
# konsol browser di tenant sungguhan (peta tracking, halaman marketing, layar
# payroll) sampai bersih, baru set true. Menegakkannya tanpa dicek akan
# mematikan halaman yang memuat host pihak ketiga yang belum terdaftar di
# config/security.php.
SECURITY_CSP_ENFORCE=false

# HSTS hanya dikirim di produksi lewat HTTPS. Nyalakan preload hanya kalau
# domain memang didaftarkan ke daftar preload browser.
SECURITY_HSTS_ENABLED=true
SECURITY_HSTS_PRELOAD=false

# Masa simpan jejak (hari). 0 = simpan selamanya.
SECURITY_RETENTION_ACTIVITY=180
SECURITY_RETENTION_AUDIT=1095
SECURITY_RETENTION_DEVICES=365
SECURITY_RETENTION_NOTIFICATIONS=180

# Backup terjadwal. Arahkan BACKUP_DISK ke disk di luar server ini di produksi:
# salinan yang duduk di server yang sama dengan databasenya selamat dari
# kesalahan, bukan dari kebakaran.
BACKUP_DISK=local
BACKUP_DIRECTORY=backups
BACKUP_KEEP_DAYS=14

# Ambang deteksi anomali harian. Naikkan kalau notifikasinya terlalu berisik.
SECURITY_ANOMALY_ENABLED=true
SECURITY_ANOMALY_FAILED_LOGINS=10
SECURITY_ANOMALY_DISTINCT_IPS=4
SECURITY_ANOMALY_EXPORTS=15
